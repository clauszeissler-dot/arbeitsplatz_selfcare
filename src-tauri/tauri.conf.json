{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lotse",
  "version": "0.2.0",
  "identifier": "de.kiaffairs.lotse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lotse – Cockpit",
        "url": "index.html",
        "width": 1080,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1a1a1a"
      },
      {
        "label": "toast",
        "title": "Lotse Hinweis",
        "url": "toast.html",
        "width": 380,
        "height": 380,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBRjVFRDkxOUY0MjlBRUIKUldUcm1rS2ZrZTMxK2lTS3JVZzlvUVExS3R2ZnBibnlXbTBKU0YrQTRka0FjczV3SURWLzJienQK",
      "endpoints": [
        "https://github.com/clauszeissler-dot/arbeitsplatz_selfcare/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Belastungs-Ampel und Pausen-Lotse für KI-Arbeit",
    "copyright": "© 2026 KI AffAIrs – Claus Zeißler",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "digestAlgorithm": "sha256"
    }
  }
}
